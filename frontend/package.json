    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxfmt": ">=0.64.0",
    "oxlint": ">=1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",

{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "worker-configuration.d.ts", "drizzle.config.ts"]
}
